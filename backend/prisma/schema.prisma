generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------
// 1. Core Users & Staff (المستخدمين والموظفين)
// -------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PATIENT") // PATIENT, DOCTOR, NURSE, RECEPTION, ADMIN, MANAGER, FINANCIAL_MANAGER, OPERATIONS_MANAGER, PHARMACIST, LAB_TECH, STAFF
  phone     String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  Doctor?
  patientProfile Patient?
  staffProfile   Staff?
  
  attendance     Attendance[]
  articles       Article[]
  approvedPayrolls Payroll[] @relation("PayrollApprover")
  reviewedLeaves   LeaveRequest[] @relation("LeaveReviewer")
  uploadedFiles    PatientFile[] @relation("FileCreator")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  headId      Int?     // مدير القسم
  
  doctors     Doctor[]
  wards       Ward[]
}

model Staff {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  category      String   @default("MEDICAL") // MEDICAL, ADMIN_STAFF, SECURITY, CLEANING, MAINTENANCE
  jobTitle      String   // ممرض، موظف استقبال، الخ
  shift         String?  // صباحي، مسائي
  salary        Float?
  allowances    Float?
  hireDate      DateTime @default(now())
  nationalId    String?  @unique
  address       String?
  department    String?
  notes         String?

  nurseNotes         NurseNote[]
  nursingAssignments NursingAssignment[]
  payrolls           Payroll[]
  salaryAdjustments  SalaryAdjustment[]
  leaveRequests      LeaveRequest[]
}

model Doctor {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  
  specialty    String
  consultFee   Float
  clinicNumber String?
  
  appointments Appointment[]
  admissions   Admission[]
  labOrders    LabOrder[]
  radiologyRecords RadiologyRecord[]
}

model Patient {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  
  nationalId      String?  @unique
  dateOfBirth     DateTime?
  gender          String?
  bloodType       String?
  weight          Float?
  height          Float?
  emergencyContact String?
  
  allergies       String? 
  chronicDiseases String?
  
  appointments    Appointment[]
  admissions      Admission[]
  invoices        Invoice[]
  policies        InsurancePolicy[]
  radiologyRecords RadiologyRecord[]
  files           PatientFile[]
}

// -------------------------------------------------
// 2. Appointments, Triage & Queue (المواعيد والفرز والطابور)
// -------------------------------------------------

model Appointment {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    Int
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  admissionId Int?
  admission   Admission? @relation(fields: [admissionId], references: [id])
  
  date        DateTime
  timeSlot    String?
  status      String   @default("SCHEDULED") // SCHEDULED, WAITING, IN_PROGRESS, COMPLETED, CANCELLED, REJECTED
  type        String   @default("CHECKUP") // كشف، متابعة، طوارئ, FOLLOWUP_INPATIENT
  queueNumber Int?
  rejectionReason String?

  triage        Triage?
  medicalRecord MedicalRecord?

  @@index([status])
  @@index([patientId])
}

model Triage {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  
  bloodPressure String?
  heartRate     Int?
  temperature   Float?
  oxygenLevel   Int?
  priorityLevel String   @default("NORMAL") // تصنيف الخطورة: منخفض، طبيعي، عاجل، حرج
  notes         String?
  
  recordedAt    DateTime @default(now())
}

// -------------------------------------------------
// 3. Clinical & Medical Records (السجلات الطبية)
// -------------------------------------------------

model MedicalRecord {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  
  complaint     String?
  diagnosis     String?
  treatmentPlan String?
  notes         String?
  
  prescriptions Prescription[]
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// -------------------------------------------------
// 4. Inpatient & Ward Management (التنويم وغرف المستشفى)
// -------------------------------------------------

model Ward {
  id           Int        @id @default(autoincrement())
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  type         String     // عناية مركزة، طوارئ، عام
  capacity     Int
  
  rooms        Room[]
}

model Room {
  id          Int    @id @default(autoincrement())
  wardId      Int
  ward        Ward   @relation(fields: [wardId], references: [id])
  roomNumber  String
  type        String // خاص، مشترك
  pricePerDay Float
  
  beds        Bed[]
}

model Bed {
  id          Int      @id @default(autoincrement())
  roomId      Int
  room        Room     @relation(fields: [roomId], references: [id])
  bedNumber   String
  isOccupied  Boolean  @default(false)
  
  admissions  Admission[]
  nursingAssignments NursingAssignment[]
}

model Admission {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    Int
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  bedId       Int
  bed         Bed      @relation(fields: [bedId], references: [id])
  
  reason      String
  status      String   @default("ADMITTED") // منوم، خرج
  admittedAt  DateTime @default(now())
  dischargedAt DateTime?

  followUpAppointments Appointment[]
  nurseNotes         NurseNote[]

  @@index([patientId])
}

model NurseNote {
  id          Int      @id @default(autoincrement())
  admissionId Int
  admission   Admission @relation(fields: [admissionId], references: [id])
  nurseId     Int
  nurse       Staff    @relation(fields: [nurseId], references: [id])
  content     String
  vitalSigns  String?
  createdAt   DateTime @default(now())
}

model NursingAssignment {
  id          Int      @id @default(autoincrement())
  nurseId     Int
  nurse       Staff    @relation(fields: [nurseId], references: [id])
  bedId       Int
  bed         Bed      @relation(fields: [bedId], references: [id])
  shift       String
  assignedAt  DateTime @default(now())
  isActive    Boolean  @default(true)
}

// -------------------------------------------------
// 5. Pharmacy & Inventory (الصيدلية والأدوية)
// -------------------------------------------------

model Medicine {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  genericName String?
  category    String   // أقراص، شراب، حقن
  stock       Int      @default(0)
  price       Float
  expiryDate  DateTime?
  
  prescriptionItems PrescriptionItem[]
}

model Prescription {
  id              Int      @id @default(autoincrement())
  medicalRecordId Int
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  status          String   @default("PENDING") // معلقة، تم صرفها
  
  items           PrescriptionItem[]
  createdAt       DateTime @default(now())

  @@index([status])
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId     Int?
  medicine       Medicine?    @relation(fields: [medicineId], references: [id])
  medicineName   String?      // اسم الدواء في حال لم يكن مسجلاً بالصيدلية
  
  dosage         String
  frequency      String       // مثل: 3 مرات يومياً
  duration       String       // مثل: 5 أيام
  quantity       Int
}

// -------------------------------------------------
// 6. Laboratory & Radiology (المعامل والأشعة)
// -------------------------------------------------

model LabTestCatalog {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  type        String   // دم، بول، أشعة، رنين مغناطيسي
  cost        Float
  
  labOrders   LabOrder[]
}

model LabOrder {
  id          Int      @id @default(autoincrement())
  patientId   Int?     
  doctorId    Int
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  testId      Int
  test        LabTestCatalog @relation(fields: [testId], references: [id])
  
  status      String   @default("PENDING") // بانتظار العينة، مكتمل
  result      String?  // رابط النتيجة أو النص
  resultValue String?  // القيمة مثل 120 mg/dL
  isNormal    Boolean?
  
  orderedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status])
}

// -------------------------------------------------
// 7. Billing & Insurance (الفواتير والتأمين)
// -------------------------------------------------

model InsuranceCompany {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  email       String?
  phone       String?
  
  policies    InsurancePolicy[]
  claims      Claim[]
}

model InsurancePolicy {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])
  companyId   Int
  company     InsuranceCompany @relation(fields: [companyId], references: [id])
  
  policyNumber String  @unique
  coveragePct  Float   // نسبة التغطية (مثلاً 0.8 يعني 80%)
  expiryDate   DateTime
}

model Invoice {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])
  
  subtotal    Float    @default(0.0)
  tax         Float    @default(0.0)
  discount    Float    @default(0.0)
  totalAmount Float
  
  status      String   @default("UNPAID") // مدفوعة، غير مدفوعة، جزئية
  
  items       InvoiceItem[]
  payments    Payment[]
  claims      Claim[]
  
  createdAt   DateTime @default(now())
  dueDate     DateTime?

  @@index([status])
  @@index([patientId])
  @@index([createdAt])
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  
  description String   // كشف طبي، تحليل دم، الخ
  amount      Float
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  
  amountPaid  Float
  method      String   // كاش، بطاقة ائتمان، تأمين
  transactionId String?
  
  paidAt      DateTime @default(now())
}

model Claim {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  companyId   Int
  company     InsuranceCompany @relation(fields: [companyId], references: [id])
  
  claimedAmount Float
  status        String   @default("SUBMITTED") // مقدمة، مقبولة، مرفوضة
  remarks       String?
  
  submittedAt   DateTime @default(now())
}

// -------------------------------------------------
// 8. Radiology, Blood Bank & Other Medical Records
// -------------------------------------------------

model RadiologyRecord {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    Int
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  
  type        String   // X-Ray, MRI, CT Scan, Ultrasound
  description String?
  fileUrl     String   // رابط ملف الأشعة
  uploadedAt  DateTime @default(now())
}

enum FileCategory {
  RADIOLOGY
  LAB_RESULT
  REPORT
  OTHER
}

model PatientFile {
  id          Int      @id @default(autoincrement())
  patientId   Int
  patient     Patient  @relation(fields: [patientId], references: [id])

  fileName    String
  fileType    String
  fileUrl     String
  fileSize    Int?
  category    FileCategory @default(OTHER)
  description String?

  createdById Int?
  createdBy   User?    @relation("FileCreator", fields: [createdById], references: [id])

  uploadedAt  DateTime @default(now())

  @@index([patientId])
}

model BloodDonation {
  id            Int      @id @default(autoincrement())
  donorName     String
  nationalId    String
  bloodType     String
  quantity      Float    // بالمليلتر
  donationDate  DateTime @default(now())
  status        String   @default("TESTING") // قيد الفحص، صالح، غير صالح، مستخدم
  notes         String?
}

// -------------------------------------------------
// 9. Operational Management & HR (الإدارة التشغيلية والموارد البشرية)
// -------------------------------------------------

model Attendance {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  date        DateTime @default(now()) // Can be stored as DATE only via app logic
  checkIn     DateTime?
  checkOut    DateTime?
  status      String   @default("PRESENT") // حاضر، غائب، إجازة، متأخر
  notes       String?
  
  @@unique([userId, date])
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------
// 10. Payroll & Leave Management (الرواتب والإجازات)
// -------------------------------------------------

model Payroll {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Staff    @relation(fields: [employeeId], references: [id])
  month         Int
  year          Int
  baseSalary    Float    @default(0.0)
  allowances    Float    @default(0.0)
  deductions    Float    @default(0.0)
  overtime      Float    @default(0.0)
  bonus         Float    @default(0.0)
  netSalary     Float    @default(0.0)
  paymentStatus String   @default("PENDING") // PENDING, APPROVED, PAID
  paidAt        DateTime?
  approvedBy    Int?
  approver      User?    @relation(name: "PayrollApprover", fields: [approvedBy], references: [id])
  createdAt     DateTime @default(now())

  items         PayrollItem[]

  @@unique([employeeId, month, year])
}

model PayrollItem {
  id          Int      @id @default(autoincrement())
  payrollId   Int
  payroll     Payroll  @relation(fields: [payrollId], references: [id])
  type        String   // ALLOWANCE, DEDUCTION, OVERTIME, BONUS
  amount      Float
  description String?
  createdAt   DateTime @default(now())
}

model SalaryAdjustment {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Staff    @relation(fields: [employeeId], references: [id])
  type        String   // ALLOWANCE, DEDUCTION, BONUS
  amount      Float
  reason      String
  month       Int
  year        Int
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Staff    @relation(fields: [employeeId], references: [id])
  leaveType   String   // ANNUAL, SICK, UNPAID, MATERNITY
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  Int?
  reviewer    User?    @relation(name: "LeaveReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}
